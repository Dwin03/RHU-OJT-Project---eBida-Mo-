<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="415dp"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:background="@color/lightGrayishBlue"
    tools:context=".personalDetails">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:foregroundGravity="center"
        android:scrollbars="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/back_button"
                android:layout_marginBottom="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/romanNum2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:fontFamily="@font/romanus"
                    android:text="II."
                    android:textColor="@color/black"
                    android:textSize="35sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/questionTwoLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:fontFamily="@font/nimbus_san_regular"
                    android:text="Detalye ng Nagbibida"
                    android:textColor="@color/black"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    tools:layout_editor_absoluteX="16dp"
                    tools:layout_editor_absoluteY="600dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="10dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pangalan ng nagbibida: "
                        android:fontFamily="@font/nimbus_san_regular"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/black"
                        android:textSize="20sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/round_corners"
                        android:padding="5dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/informantName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray"
                            android:fontFamily="@font/nimbus_san_regular"
                            android:hint="Ilagay ang sagot. . ." />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tirahan ng nagbibida: "
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/black"
                        android:fontFamily="@font/nimbus_san_regular"
                        android:textSize="20sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/round_corners"
                            android:padding="5dp"
                            android:layout_marginBottom="2dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/informantAddress"
                                android:layout_width="295dp"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:textColor="@color/black"
                                android:textColorHint="@color/gray"
                                android:focusable="false"
                                android:fontFamily="@font/nimbus_san_regular"
                                android:longClickable="false"
                                android:hint="Pumili. . . " />

                            <ImageButton
                                android:id="@+id/infoAddressDropDown"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/down"
                                android:layout_gravity="center"/>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/infoAddressDropDownRecyclerViewHolder"
                            android:layout_width="330dp"
                            android:layout_height="wrap_content"
                            android:background="@color/darkBlue"
                            android:fontFamily="@font/nimbus_san_regular"
                            android:overScrollMode="never"
                            android:visibility="gone"
                            android:layout_gravity="center" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contact No. ng nagbibida: "
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/nimbus_san_regular"
                        android:textColor="@color/black"
                        android:textSize="20sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/round_corners"
                        android:padding="5dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/informantNum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray"
                            android:fontFamily="@font/nimbus_san_regular"
                            android:hint="Ilagay ang sagot. . ."
                            android:maxLength="11" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/romanNum3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:fontFamily="@font/romanus"
                        android:text="III."
                        android:textColor="@color/black"
                        android:textSize="35sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/questionThreeLabel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="5dp"
                        android:text="Detalye ng Kliyente / Pasyente"
                        android:fontFamily="@font/nimbus_san_regular"
                        android:textColor="@color/black"
                        android:textSize="30sp"
                        android:textStyle="bold"
                        tools:layout_editor_absoluteX="16dp"
                        tools:layout_editor_absoluteY="600dp" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pangalan ng kliyente / pasyente: "
                        android:fontFamily="@font/nimbus_san_regular"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/black"
                        android:textSize="20sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/round_corners"
                        android:padding="5dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/patientName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="text"
                            android:fontFamily="@font/nimbus_san_regular"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray"
                            android:hint="Ilagay ang sagot. . ." />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Edad ng kliyente / pasyente: "
                        android:fontFamily="@font/nimbus_san_regular"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/black"
                        android:textSize="20sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/round_corners"
                        android:padding="5dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/patientAge"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:fontFamily="@font/nimbus_san_regular"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray"
                            android:hint="Ilagay ang sagot. . ." />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Kasarian ng kliyente / pasyente: "
                        android:fontFamily="@font/nimbus_san_regular"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/black"
                        android:textSize="20sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/round_corners"
                            android:padding="5dp"
                            android:layout_marginBottom="2dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/patientSex"
                                android:layout_width="295dp"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:fontFamily="@font/nimbus_san_regular"
                                android:textColor="@color/black"
                                android:focusable="false"
                                android:longClickable="false"
                                android:textColorHint="@color/gray"
                                android:hint="Pumili. . . " />

                            <ImageButton
                                android:id="@+id/patientSexDropDown"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/down"
                                android:layout_gravity="center"/>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/patientSexDropDownRecyclerViewHolder"
                            android:layout_width="330dp"
                            android:layout_height="wrap_content"
                            android:background="@color/darkBlue"
                            android:fontFamily="@font/nimbus_san_regular"
                            android:overScrollMode="never"
                            android:visibility="gone"
                            android:layout_gravity="center" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Tirahan ng kliyente / pasyente: "
                        android:fontFamily="@font/nimbus_san_regular"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/black"
                        android:textSize="20sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:layout_marginBottom="10dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/round_corners"
                            android:padding="5dp"
                            android:layout_marginBottom="2dp"
                            android:orientation="horizontal">

                            <EditText
                                android:id="@+id/patientAddress"
                                android:layout_width="295dp"
                                android:layout_height="wrap_content"
                                android:inputType="text"
                                android:fontFamily="@font/nimbus_san_regular"
                                android:textColor="@color/black"
                                android:focusable="false"
                                android:longClickable="false"
                                android:textColorHint="@color/gray"
                                android:hint="Pumili. . . " />

                            <ImageButton
                                android:id="@+id/patientAddressDropDown"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/down"
                                android:layout_gravity="center"/>

                        </LinearLayout>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/patientAddressDropDownRecyclerViewHolder"
                            android:layout_width="330dp"
                            android:layout_height="wrap_content"
                            android:background="@color/darkBlue"
                            android:fontFamily="@font/nimbus_san_regular"
                            android:overScrollMode="never"
                            android:visibility="gone"
                            android:layout_gravity="center" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Contact No. ng kliyente / pasyente: "
                        android:fontFamily="@font/nimbus_san_regular"
                        android:layout_marginBottom="10dp"
                        android:textColor="@color/black"
                        android:textSize="20sp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/round_corners"
                        android:padding="5dp"
                        android:layout_marginBottom="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/patientNum"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:fontFamily="@font/nimbus_san_regular"
                            android:textColor="@color/black"
                            android:textColorHint="@color/gray"
                            android:hint="Ilagay ang sagot. . ."
                            android:maxLength="11" />

                    </LinearLayout>

                </LinearLayout>

                <Button
                    android:id="@+id/submitBtn"
                    android:layout_width="119dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:backgroundTint="@color/darkBlue"
                    android:layout_marginBottom="10dp"
                    android:text="Ipasa"
                    android:fontFamily="@font/nimbus_san_regular"
                    android:textColor="@color/white"
                    tools:layout_editor_absoluteX="159dp"
                    tools:layout_editor_absoluteY="677dp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>